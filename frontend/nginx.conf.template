# Rendered by the nginx image's entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# Only defined env vars are substituted, so nginx's own $variables are left alone.

# Behind Azure Front Door, only accept requests carrying our profile's X-Azure-FDID
# (the AzureFrontDoor.Backend service tag alone also admits other Front Door
# customers). FRONT_DOOR_ID empty = check disabled.
# The "<id>:<id>" key is 73 characters; the default bucket size is the CPU cache line
# (64 bytes on most nodes), which is too small and stops nginx from starting.
map_hash_bucket_size 128;
map "${FRONT_DOOR_ID}:$http_x_azure_fdid" $front_door_denied {
    default                             1;
    "~^:"                               0;
    "${FRONT_DOOR_ID}:${FRONT_DOOR_ID}" 0;
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Kubelet and Front Door health probes; never gated.
    location = /healthz {
        access_log off;
        return 200 'ok';
    }

    # Proxy API calls to the backend tier. On AKS the ingress also routes /api
    # straight to the backend; this keeps the container usable on its own.
    location /api/ {
        if ($front_door_denied) { return 403; }
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed build assets can be cached forever.
    location /assets/ {
        if ($front_door_denied) { return 403; }
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA fallback.
    location / {
        if ($front_door_denied) { return 403; }
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
